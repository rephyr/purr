/* purr's look */

/* The background colours ($bg, $panel, $line, ...) come from the theme: tui/themes.py. */

Screen {
    layers: base above;
    background: $bg;
    color: #e9dff2;
}

#chat {
    padding: 0 2 1 2;
    scrollbar-size-vertical: 1;
    scrollbar-color: $line-hi;
    scrollbar-color-hover: $scroll;
    scrollbar-background: $bg;
}

.user {
    margin-top: 1;
    padding: 1 2;
    border-left: outer $pink;
    background: $panel;
    color: #f7d6ea;
}

.assistant {
    margin: 1 0 0 0;
    padding: 0 1;
    background: transparent;
}
.assistant > *:last-child {
    margin-bottom: 0;
}

.line {
    padding: 0 1;
}
.tool { margin-top: 1; }
.dim { color: #82788f; padding-left: 3; }
.stats { margin-top: 1; }
.info { color: $lilac; margin-top: 1; }
.warn { color: $peach; margin-top: 1; }
.error { color: #f0829b; margin-top: 1; }

/* a change: a rounded card, file name in the top border (tui/diffview.py draws the rows) */
.diff {
    margin: 1 0 0 1;
    padding: 0;
    border: round $line;
    border-title-align: left;
    background: transparent;
}

.output {
    padding: 0 1 0 3;
}

.todos {
    margin-top: 1;
    padding: 0 2;
    border-left: outer $scroll;
}

.thinking {
    margin-top: 1;
    padding: 0;
    border: none;
    background: transparent;
}
.thinking CollapsibleTitle {
    color: #82788f;
    background: transparent;
    padding: 0 1;
    text-style: none;
}
.thinking CollapsibleTitle:hover, .thinking CollapsibleTitle:focus {
    color: $lilac;
    background: transparent;
}
.thinking Contents {
    padding: 0 0 0 1;
    margin-left: 1;
    border-left: outer $line;
}
.thinking-text {
    color: #6f6580;
}

/* ---- layout: start screen (.home) vs chat ---- */

#main {
    height: 1fr;
}
.home #main {
    align-vertical: middle;
}
#dockrow {
    height: auto;
}

#chat {
    height: 1fr;
}
.home #chat {
    display: none;
}

#logo {
    display: none;
    width: 100%;
    text-align: center;
    margin-bottom: 2;
}
.home #logo {
    display: block;
}

#dock {
    height: auto;
    padding: 0 2 1 2;
}
.home #dock {
    width: 80;
    max-width: 100%;
    padding: 0 2;
}

#menu {
    display: none;
    layer: above;
    position: absolute;
    border: none;
    padding: 0 1;
    background: $panel-hi;
    scrollbar-size-vertical: 1;
}
#menu.show {
    display: block;
}
#menu > .option-list--option-highlighted {
    background: $hover;
}

/* the cat on top of the message box: shows what purr is doing (tui/cat.py) */
#cat {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
}

/* the message box: a lighter panel with a bar on the left, like OpenCode */
#box {
    height: auto;
    padding: 1 2;
    background: $panel;
    border-left: outer $lilac;
}
#box:focus-within {
    border-left: outer $pink;
}
#prompt, #prompt:focus {
    height: auto;
    max-height: 10;
    padding: 0;
    border: none;
    background: transparent;
    scrollbar-size-vertical: 1;
}
#prompt > .text-area--placeholder {
    color: #6f6580;
}
#prompt > .text-area--cursor-line {
    background: transparent;
}
#prompt > .text-area--selection {
    background: $line-hi;
}
#modelline {
    height: 1;
    margin-top: 1;
}
#model {
    width: 1fr;
}
#status {
    width: auto;
}

#under {
    height: 1;
    margin-top: 1;
}
#where {
    width: 1fr;
    margin-right: 2;
}
#keys {
    width: auto;
}

#version {
    display: none;
    dock: bottom;
    width: 100%;
    padding: 0 3 1 0;
    text-align: right;
    color: #5e5469;
}
.home #version {
    display: block;
}

AskScreen {
    align: center middle;
    background: $shade 70%;
}
#askbox {
    width: 72;
    max-width: 95%;
    height: auto;
    padding: 1 2;
    border: round $peach;
    background: $popup;
}
#question {
    color: $peach;
    margin-bottom: 1;
}
#buttons {
    height: auto;
    margin-bottom: 1;
}
#buttons Button {
    margin-right: 2;
    min-width: 12;
    border: none;
    background: $button;
    color: #e9dff2;
}
#buttons Button:focus {
    background: $pink;
    color: $deep;
    text-style: bold;
}
#reason {
    border: round $line-hi;
    background: $deep;
}
#reason:focus {
    border: round $lilac;
}

Picker {
    align: center middle;
    background: $shade 60%;
}
#pickbox {
    width: 84;
    max-width: 95%;
    height: auto;
    padding: 1 2;
    background: $panel;
    border-left: outer $lilac;
}
#picktitle {
    color: $pink;
    text-style: bold;
    margin-bottom: 1;
}
#search, #search:focus {
    height: 1;
    padding: 0;
    margin-bottom: 1;
    border: none;
    background: transparent;
}
#picklist {
    height: auto;
    max-height: 16;
    padding: 0;
    border: none;
    background: transparent;
}
#picklist > .option-list--option-highlighted {
    background: $hover;
}

/* a tool line opens on click to show the exact call and its result */
.toolline {
    height: auto;
}
.tooldetails {
    display: none;
    margin: 0 0 0 3;
    padding: 0 1;
    border-left: outer $line;
}
.toolline.open .tooldetails {
    display: block;
}
.toolline.open .tool {
    color: $lilac;
}

/* your latest message, pinned above the chat once it scrolls out of sight */
#pinned {
    display: none;
    height: 1;
    margin: 0 2 1 2;
    padding: 0 2;
    background: $panel;
    border-left: outer $pink;
}
#pinned.show {
    display: block;
}
.home #pinned {
    display: none;
}

/* the refine popup: your message rewritten into a clear task, editable */
RefineScreen {
    align: center middle;
    background: $shade 70%;
}
#refinebox {
    width: 90;
    max-width: 95%;
    height: auto;
    padding: 1 2;
    border: round $pink;
    background: $popup;
}
#refineorig {
    margin: 1 0;
}
#refined, #refined:focus {
    height: auto;
    max-height: 18;
    padding: 1;
    border: none;
    background: $deep;
}
#refinehint {
    margin-top: 1;
}

/* the pull request popup */
PRScreen {
    align: center middle;
    background: $shade 70%;
}
#prbox {
    width: 90;
    max-width: 95%;
    height: auto;
    padding: 1 2;
    border: round $pink;
    background: $popup;
}
#prname, #prname:focus {
    margin: 1 0 0 0;
    border: none;
    padding: 0 1;
    background: $deep;
}
#prbody, #prbody:focus {
    height: auto;
    max-height: 14;
    margin: 1 0;
    padding: 1;
    border: none;
    background: $deep;
}
#prhint {
    margin-top: 1;
}

/* the plan popup: the tickets, before any of them run */
PlanScreen {
    align: center middle;
    background: $shade 70%;
}
#planbox {
    width: 90;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $pink;
    background: $popup;
}
#plantitle {
    color: $pink;
    text-style: bold;
    margin-bottom: 1;
}
#planlist {
    height: auto;
    max-height: 18;
    background: transparent;
    scrollbar-size-vertical: 1;
}
.planticket {
    margin-bottom: 1;
}
#planwhere, #planhint {
    margin-top: 1;
}
